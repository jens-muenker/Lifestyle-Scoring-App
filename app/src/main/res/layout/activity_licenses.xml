<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.activities.LicensesActivity">

    <LinearLayout
        android:id="@+id/header_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="?attr/colorSurface"
            android:contentInsetEnd="0dp"
            android:contentInsetStart="0dp"
            android:elevation="0dp"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingStart="0dp"
            android:stateListAnimator="@null"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            app:elevation="0dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginStart="@dimen/screen_horizontal_padding"
                android:background="@null"
                android:contentDescription="@string/back_to_home"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:singleLine="true"
                android:text="@string/open_source_licenses"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_title_toolbar"
                android:textStyle="bold" />
        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:id="@+id/topBarDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rec_licenses"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_block"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_medium" />

    <LinearLayout
        android:id="@+id/empty_licenses_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_block"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search_off"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/txt_licenses_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:gravity="center"
            android:text="@string/failed_to_load_licenses"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
</RelativeLayout>
