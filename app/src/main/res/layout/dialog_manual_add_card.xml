<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_small"
    android:paddingStart="@dimen/spacing_small"
    android:paddingEnd="@dimen/spacing_small">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_layout_manual_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/manual_card_search_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_manual_card_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords" />

    </com.google.android.material.textfield.TextInputLayout>

    <ListView
        android:id="@+id/list_manual_cards"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:dividerHeight="0dp"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small" />

    <TextView
        android:id="@+id/text_manual_no_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingBottom="@dimen/spacing_small"
        android:text="@string/manual_card_no_results"
        android:visibility="gone" />

</LinearLayout>
