<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.frosch2010.lifestyle_scoring_app.ui.viewmodels.ScanCardViewModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        tools:context=".ui.activities.ScanCardActivity">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/a11y_camera_preview" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:layout_alignParentTop="true"
            android:background="?attr/colorSurfaceContainer"
            android:contentInsetEnd="0dp"
            android:contentInsetLeft="0dp"
            android:contentInsetRight="0dp"
            android:contentInsetStart="0dp"
            android:elevation="0dp"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingStart="0dp"
            android:stateListAnimator="@null"
            app:contentInsetEnd="0dp"
            app:contentInsetLeft="0dp"
            app:contentInsetRight="0dp"
            app:contentInsetStart="0dp"
            app:elevation="0dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginStart="@dimen/screen_horizontal_padding"
                android:background="@null"
                android:contentDescription="@string/back_to_home"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:ellipsize="end"
                android:paddingStart="15dp"
                android:paddingEnd="0dp"
                android:singleLine="true"
                android:text="@string/scan_card"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_title_toolbar"
                android:textStyle="bold" />
        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/helpCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/toolbar"
            android:layout_marginStart="@dimen/screen_horizontal_padding"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginEnd="@dimen/screen_horizontal_padding"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/helpLabel"
                style="@style/FontSizeMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_small"
                android:text="@string/only_card_names_are_important"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurface" />
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/scanProgressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:contentDescription="@string/a11y_scanning_in_progress"
            android:elevation="4dp"
            android:indeterminate="true"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/scanningLabel"
            style="@style/FontSizeMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/scanProgressBar"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/scanning"
            android:textAlignment="center"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/txt_camera_error"
            style="@style/FontSizeMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/screen_horizontal_padding"
            android:layout_marginEnd="@dimen/screen_horizontal_padding"
            android:background="?attr/colorErrorContainer"
            android:elevation="6dp"
            android:gravity="center"
            android:padding="@dimen/spacing_medium"
            android:scrollbars="vertical"
            android:textColor="?attr/colorOnErrorContainer"
            android:visibility="gone"
            tools:text="@string/scan_camera_error_generic"
            tools:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/screen_horizontal_padding"
            android:layout_marginEnd="@dimen/screen_horizontal_padding"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualAdd"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/add_card_manually"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/add_card_manually"
                app:icon="@drawable/ic_google_playing_cards"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cameraCaptureButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/a11y_scan_capture"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/scan_card"
                app:icon="@drawable/ic_scan_card"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="?attr/colorOnPrimary" />
        </LinearLayout>

    </RelativeLayout>
</layout>
